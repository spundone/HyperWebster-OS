#!/bin/bash
# hyperwebster-blur-toggle — frosted glass for shell panels and launcher.
# Fresh installs enable blur by default; disable for a fully flat look.
# Corner rounding is separate: hyperwebster-rounding-toggle.
#
# NoSignal top bar is WlrLayershell namespace "nsbar"; popups use "nspanels".
# Older rules matched caelestia-.* / qs-.* and never blurred the bar.
#
# ignore_alpha must stay BELOW Theme.barBg alpha (~0.60). Hyprland ignores
# pixels with opacity <= ignore_alpha for blur; caelestia's default
# (transparency.base - 0.03 ≈ 0.69) sits above the bar fill and kills frost.
set -euo pipefail

HYPRVARS="${HOME}/.config/caelestia/hypr-vars.conf"
HYPRVARS_LUA="${HOME}/.config/caelestia/hypr-vars.lua"
SHELLJSON="${HOME}/.config/caelestia/shell.json"
OVCFG="${HOME}/.config/quickshell/overview/config.json"
HYPRUSER="${HOME}/.config/caelestia/hypr-user.conf"
STATE="${HOME}/.local/state/hyperwebster/blur-enabled"
MARK_BEGIN='# >>> hyperwebster-blur-toggle >>>'
MARK_END='# <<< hyperwebster-blur-toggle <<<'
# Keep under Theme.barBg alpha (~0.60) so the glass fill is blurred.
NSBAR_IGNORE_ALPHA='0.40'

usage() {
  echo "Usage: hyperwebster-blur-toggle {enable|disable|status|toggle}" >&2
}

json_merge_transparency() {
  local enabled="$1"
  if command -v jq >/dev/null 2>&1 && [ -f "$SHELLJSON" ]; then
    local tmp
    tmp=$(mktemp)
    jq --argjson en "$enabled" \
      '.appearance.transparency = (.appearance.transparency // {}) | .appearance.transparency.enabled = $en | .appearance.transparency.base = (if $en then 0.72 else 1.0 end) | .appearance.transparency.layers = (if $en then 0.35 else 0.4 end)' \
      "$SHELLJSON" > "$tmp" && mv "$tmp" "$SHELLJSON"
  fi
}

set_hyprvars() {
  local on="$1"
  if [ -f "$HYPRVARS" ]; then
    if [ "$on" = 1 ]; then
      sed -i \
        -e 's/^\$blurEnabled = .*/$blurEnabled = true/' \
        -e 's/^\$blurPopups = .*/$blurPopups = true/' \
        -e 's/^\$windowOpacity = .*/$windowOpacity = 0.92/' \
        "$HYPRVARS"
      # Ensure size/passes exist (flat installs may never have set them).
      grep -q '^\$blurSize = ' "$HYPRVARS" 2>/dev/null || echo '$blurSize = 10' >> "$HYPRVARS"
      grep -q '^\$blurPasses = ' "$HYPRVARS" 2>/dev/null || echo '$blurPasses = 3' >> "$HYPRVARS"
      sed -i -e 's/^\$blurSize = .*/$blurSize = 10/' -e 's/^\$blurPasses = .*/$blurPasses = 3/' "$HYPRVARS"
    else
      sed -i \
        -e 's/^\$blurEnabled = .*/$blurEnabled = false/' \
        -e 's/^\$blurPopups = .*/$blurPopups = false/' \
        -e 's/^\$windowOpacity = .*/$windowOpacity = 1.0/' \
        "$HYPRVARS"
    fi
  fi

  # Lua-era caelestia (hypr-vars.lua) — keep in sync when present / creatable.
  if [ "$on" = 1 ]; then
    mkdir -p "$(dirname "$HYPRVARS_LUA")"
    cat > "$HYPRVARS_LUA" <<'LUA'
-- HyperWebster frosted glass (synced by hyperwebster-blur-toggle).
return {
    blurEnabled = true,
    blurPopups = true,
    blurInputMethods = true,
    blurSize = 10,
    blurPasses = 3,
    windowOpacity = 0.92,
}
LUA
  elif [ -f "$HYPRVARS_LUA" ]; then
    cat > "$HYPRVARS_LUA" <<'LUA'
-- HyperWebster flat look (synced by hyperwebster-blur-toggle).
return {
    blurEnabled = false,
    blurPopups = false,
    blurInputMethods = false,
    windowOpacity = 1.0,
}
LUA
  fi
}

set_overview() {
  local on="$1"
  [ -f "$OVCFG" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    local tmp
    tmp=$(mktemp)
    jq --argjson en "$on" \
      '.overview.effects.enableBlur = $en | .overview.effects.enableBackdrop = $en | .overview.effects.glassMode = $en' \
      "$OVCFG" > "$tmp" && mv "$tmp" "$OVCFG"
  fi
}

blur_block() {
  cat <<EOF
# >>> hyperwebster-blur-toggle >>>
# Frosted glass for NoSignal NsBar / panels (Hyprland 0.55+ rule syntax).
# Namespaces: nsbar (top bar), nspanels (popouts). Keep caelestia-drawers for
# any leftover drawer surfaces. ignore_alpha ${NSBAR_IGNORE_ALPHA} must stay
# below Theme.barBg (~0.60) or the bar fill is skipped for blur.
layerrule = blur on, match:namespace nsbar
layerrule = ignore_alpha ${NSBAR_IGNORE_ALPHA}, match:namespace nsbar
layerrule = blur on, match:namespace nspanels
layerrule = ignore_alpha ${NSBAR_IGNORE_ALPHA}, match:namespace nspanels
layerrule = blur on, match:namespace caelestia-drawers
layerrule = ignore_alpha ${NSBAR_IGNORE_ALPHA}, match:namespace caelestia-drawers
# <<< hyperwebster-blur-toggle <<<
EOF
}

set_layer_rules() {
  local on="$1"
  [ -f "$HYPRUSER" ] || return 0
  # Always drop the previous marked block so re-enable upgrades namespaces.
  if grep -qF "$MARK_BEGIN" "$HYPRUSER" 2>/dev/null; then
    sed -i "/$MARK_BEGIN/,/$MARK_END/d" "$HYPRUSER" 2>/dev/null || true
  fi
  # Also strip legacy ignorealpha / wrong-namespace one-offs if present.
  sed -i \
    -e '/layerrule = .*match:namespace caelestia-\.\*/d' \
    -e '/layerrule = .*match:namespace qs-\.\*/d' \
    -e '/ignorealpha/d' \
    "$HYPRUSER" 2>/dev/null || true

  if [ "$on" = 1 ]; then
    printf '\n' >> "$HYPRUSER"
    blur_block >> "$HYPRUSER"
  fi
}

# Apply live keywords so frost shows without relying only on reload + Colours.
apply_live_keywords() {
  local on="$1"
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl version >/dev/null 2>&1 || return 0

  if [ "$on" = 1 ]; then
    hyprctl keyword decoration:blur:enabled true >/dev/null 2>&1 || true
    hyprctl keyword decoration:blur:size 10 >/dev/null 2>&1 || true
    hyprctl keyword decoration:blur:passes 3 >/dev/null 2>&1 || true
    hyprctl keyword decoration:blur:popups true >/dev/null 2>&1 || true
    for ns in nsbar nspanels caelestia-drawers; do
      # Hyprland requires a value: "blur on" / "blur off" (bare "blur," is invalid).
      hyprctl keyword "layerrule blur on, match:namespace ${ns}" >/dev/null 2>&1 || true
      hyprctl keyword "layerrule ignore_alpha ${NSBAR_IGNORE_ALPHA}, match:namespace ${ns}" >/dev/null 2>&1 || true
    done
  else
    hyprctl keyword decoration:blur:enabled false >/dev/null 2>&1 || true
    for ns in nsbar nspanels caelestia-drawers; do
      hyprctl keyword "layerrule blur off, match:namespace ${ns}" >/dev/null 2>&1 || true
    done
  fi
}

apply() {
  local on="$1"
  mkdir -p "$(dirname "$STATE")"
  echo "$on" > "$STATE"
  set_hyprvars "$on"
  json_merge_transparency "$on"
  set_overview "$on"
  set_layer_rules "$on"
  if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
  fi
  apply_live_keywords "$on"
  if [ "$on" = 1 ]; then
    echo "Frosted glass enabled (nsbar/nspanels blur + shell transparency)."
    echo "Restart the shell if the bar is still flat: Ctrl+Super+Alt+R"
  else
    echo "Flat/restrained look restored (blur off)."
  fi
}

case "${1:-}" in
  enable) apply 1 ;;
  disable) apply 0 ;;
  toggle)
    if [ -f "$STATE" ] && [ "$(cat "$STATE")" = 1 ]; then apply 0; else apply 1; fi
    ;;
  status)
    if [ -f "$STATE" ] && [ "$(cat "$STATE")" = 1 ]; then echo enabled; exit 0; fi
    echo disabled; exit 1
    ;;
  *) usage; exit 1 ;;
esac
