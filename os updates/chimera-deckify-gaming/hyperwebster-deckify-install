#!/bin/bash
# hyperwebster-deckify-install — gamescope Steam Big Picture session stack.
# Prefers CachyOS's gamescope-session-cachyos (already conflicts with AUR
# gamescope-session-git). Falls back to Chimera AUR -git packages only when
# the CachyOS package is unavailable.
set -euo pipefail

HELPER="${HOME}/.local/bin/omarchy-pkg-add"
LAYER="${HOME}/.local/share/hyperwebster"

echo "==> HyperWebster Deckify / Chimera gaming install"

# multilib + Omarchy shims (idempotent).
if [ -x "$LAYER/gaming-enablement/install-gaming-enablement.sh" ]; then
  sh "$LAYER/gaming-enablement/install-gaming-enablement.sh"
fi

if ! command -v yay >/dev/null 2>&1 && ! command -v pacman >/dev/null 2>&1; then
  echo "Error: pacman/yay required." >&2
  exit 1
fi

pkg_available() {
  pacman -Si "$1" >/dev/null 2>&1 || pacman -Q "$1" >/dev/null 2>&1
}

pkg_installed() {
  pacman -Q "$1" >/dev/null 2>&1
}

pkg_add() {
  # omarchy-pkg-add already runs `yay -S --needed --noconfirm` — do not pass -S
  # again (pacman: "only one operation may be used at a time").
  if [ -x "$HELPER" ]; then
    "$HELPER" "$@"
  elif command -v yay >/dev/null 2>&1; then
    yay -S --needed --noconfirm "$@"
  else
    sudo pacman -S --needed --noconfirm "$@"
  fi
}

pkg_remove() {
  local p
  for p in "$@"; do
    pkg_installed "$p" || continue
    echo "==> Removing conflicting package: $p"
    sudo pacman -Rdd --noconfirm "$p" 2>/dev/null \
      || sudo pacman -R --noconfirm "$p" 2>/dev/null \
      || true
  done
}

# --- Session packages -------------------------------------------------------
# gamescope-session-cachyos Provides/Conflicts with the Chimera AUR -git
# session packages. Installing both fails noninteractively (yay defaults N).
if pkg_available gamescope-session-cachyos; then
  echo "==> Using CachyOS gamescope-session-cachyos (Steam Big Picture session)"
  pkg_remove gamescope-session-git gamescope-session-steam-git \
    gamescope-session-plus gamescope-session-steam
  pkg_add gamescope-session-cachyos gamescope mangohud
else
  echo "==> CachyOS session package unavailable — installing Chimera AUR stack"
  pkg_remove gamescope-session-cachyos
  pkg_add gamescope-session-git gamescope-session-steam-git gamescope mangohud
fi

# Steam client (repo) if missing — session needs it for Big Picture.
if ! pkg_installed steam && ! pkg_installed steam-native-runtime; then
  echo "==> Installing Steam…"
  pkg_add steam || true
fi

# Session switch scripts (Deckify-compatible interface).
echo "==> Installing session switch helpers…"
sudo install -Dm0755 "$LAYER/chimera-deckify-gaming/switch-to-gaming" /usr/local/bin/switch-to-gaming
sudo install -Dm0755 "$LAYER/chimera-deckify-gaming/switch-to-desktop" /usr/local/bin/switch-to-desktop
sudo install -Dm0755 "$LAYER/chimera-deckify-gaming/gaming-session-switch" /usr/local/bin/gaming-session-switch
sudo install -Dm0755 "$LAYER/chimera-deckify-gaming/os-session-select" /usr/lib/os-session-select
sudo install -Dm0755 "$LAYER/chimera-deckify-gaming/hyperwebster-gaming-session" /usr/local/bin/hyperwebster-gaming-session

SESSION=$(/usr/local/bin/hyperwebster-gaming-session 2>/dev/null || true)
if [ -z "${SESSION:-}" ]; then
  echo "WARNING: no gamescope Wayland session desktop found after install." >&2
  echo "         Check: ls /usr/share/wayland-sessions/gamescope*" >&2
else
  echo "==> Detected gamescope session: $SESSION"
fi

# Password-at-boot overlay (reuses deckshift-login gate).
if [ -x "$LAYER/deckshift-login/install-deckshift-login.sh" ]; then
  sh "$LAYER/deckshift-login/install-deckshift-login.sh" || true
fi

# sudoers: passwordless session switch (Deckify pattern).
if [ ! -f /etc/sudoers.d/hyperwebster-gaming-session ]; then
  TMP=$(mktemp)
  cat > "$TMP" <<'SUDO'
# HyperWebster — gamescope session switching without a password prompt.
%wheel ALL=(ALL) NOPASSWD: /usr/local/bin/gaming-session-switch
SUDO
  if sudo visudo -cf "$TMP" >/dev/null 2>&1; then
    sudo install -m0440 "$TMP" /etc/sudoers.d/hyperwebster-gaming-session
    echo "==> sudoers rule installed"
  else
    echo "WARNING: sudoers validation failed — session switch will prompt for sudo" >&2
  fi
  rm -f "$TMP"
fi

echo
echo "Deckify / Chimera gaming stack installed."
echo "  Super+Shift+S  — switch to gamescope Steam session"
echo "  Limine Starman entry — boots straight into gaming when TPM/LUKS allow"
echo "  Reboot and pick Starman (Gaming / Steam) for controller-friendly boot"
