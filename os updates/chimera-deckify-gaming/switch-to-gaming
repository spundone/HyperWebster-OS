#!/bin/bash
# switch-to-gaming — queue SDDM restart into gamescope session.
set -euo pipefail

if ! [ -x /usr/local/bin/gaming-session-switch ]; then
  notify-send -u critical "Gaming Mode" "switch helpers missing — re-run Deckify / Chimera from Additions" 2>/dev/null || true
  exit 1
fi

if ! /usr/local/bin/hyperwebster-gaming-session >/dev/null 2>&1; then
  notify-send -u critical "Gaming Mode" "No gamescope session installed — open Additions → Deckify / Chimera" 2>/dev/null || true
  exit 1
fi

if ! sudo -n /usr/local/bin/gaming-session-switch gaming; then
  notify-send -u critical "Gaming Mode" "Session switch failed (sudoers / SDDM). Check /usr/local/bin/gaming-session-switch" 2>/dev/null || true
  exit 1
fi

nohup sudo -n systemctl restart sddm >/dev/null 2>&1 &
